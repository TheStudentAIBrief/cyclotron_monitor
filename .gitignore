# Operational database — contains sensitive facility/equipment operational
# records subject to regulatory compliance. Must NOT be committed to any
# remote repository.
data/cyclotron.db

# Generated files
data/dashboard.json
data/ALERT.txt
data/serve_access.log
data/*.db-wal
data/*.db-shm

# Config — contains absolute filesystem paths disclosing machine layout
config.json

# Trained model artifacts — pickle files are executable payloads; never commit
data/models/*.pkl
data/models/*.sha256

# Authentication — PBKDF2 hash of dashboard password; never commit
data/.credentials.json

# TLS private key — never commit; cert.pem is safe to distribute for trust-store import
data/tls/key.pem

# Compliance audit trail — monthly gzip CSV archives of historical fault events.
# Contains the same regulated data as cyclotron.db; never commit.
data/events_archive/

# EUR form audit archive — write-once per-import directories with original photos,
# OCR responses, and parsed readings. Regulatory compliance data; never commit.
data/gauge_archive/

# Raw gauge photos saved by the API on upload; not versioned.
data/gauge_photos/

# Generated QR-code gauge label PDFs; not versioned.
qr_labels/

# pip-tools compiled lockfile — commit this to pin supply chain
# requirements-lock.txt is intentionally NOT listed here

# Python
*.pyc
__pycache__/
.pytest_cache/

# Analysis scratch (contains OT-derived feature data — never commit)
scratchpad_bn/
.coverage
